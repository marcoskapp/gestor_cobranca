{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(mvn test:*)",
      "Bash(mvn verify:*)",
      "Bash(mvn -q test-compile:*)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)",
      "Bash(npm run knowledge:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(./scripts/sandbox/verify.sh:*)",
      "Bash(./scripts/sandbox/audit.sh:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.jks)",
      "Read(./**/*.tfvars)",
      "Read(./backend/config/dev/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)"
    ]
  }
}
