{
  "name": "gestor-cobranca-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "npm run icons:check && npm run bootstrap:check",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run icons:check && npm run bootstrap:check",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "lint": "ng lint",
    "icons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-icon-sprite.mjs",
    "icons:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-icon-sprite.mjs --check",
    "bootstrap:check": "node scripts/check-bootstrap-variables.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/localize": "^22.2.3",
    "@angular/material": "^22.2.4",
    "@angular/material-date-fns-adapter": "^22.2.4",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@ng-bootstrap/ng-bootstrap": "21.0.0",
    "@popperjs/core": "2.11.8",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "date-fns": "^4.4.0",
    "material-icons": "^1.13.14",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@types/qrcode": "^1.5.6",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
