# Unidade systemd da aplicação Gestor de Cobrança (instalada pelo user-data).
#
# Ambiente: /etc/gestor-cobranca/app.env (não sensível, root:gestor 0640) e
#           /etc/gestor-cobranca/secrets.env (sensível, root:root 0600, lido pelo systemd).
# Encerramento: SIGTERM → Spring Boot (server.shutdown=graceful) conclui as requisições em
# andamento; o ALB já drenou a instância (deregistration delay) antes da terminação.
[Unit]
Description=Gestor de Cobranca (Spring Boot)
Documentation=file:///opt/gestor-cobranca/VERSION
After=network-online.target amazon-cloudwatch-agent.service
Wants=network-online.target
# Sem limite de reinícios: falhas persistentes tornam a instância não saudável no ALB e o
# Auto Scaling Group a substitui.
StartLimitIntervalSec=0

[Service]
Type=exec
User=gestor
Group=gestor
WorkingDirectory=/opt/gestor-cobranca
# Padrão sobrescrito por app.env (EnvironmentFile prevalece sobre Environment).
Environment=JVM_MAX_RAM_PERCENTAGE=60
Environment=JAVA_OPTS=
EnvironmentFile=/etc/gestor-cobranca/app.env
EnvironmentFile=/etc/gestor-cobranca/secrets.env

# $JAVA_OPTS (sem chaves) é dividido em palavras pelo systemd (vazio = nenhum argumento). Sem heap dump em OOM: o
# despejo de memória conteria dados pessoais e segredos.
ExecStart=/usr/lib/jvm/java-21-amazon-corretto/bin/java \
    -XX:MaxRAMPercentage=${JVM_MAX_RAM_PERCENTAGE} \
    -XX:+ExitOnOutOfMemoryError \
    -XX:+UseG1GC \
    -Djava.io.tmpdir=/var/lib/gestor-cobranca/tmp \
    -Djava.security.egd=file:/dev/urandom \
    -Dfile.encoding=UTF-8 \
    -Duser.timezone=UTC \
    $JAVA_OPTS \
    -jar /opt/gestor-cobranca/gestor-cobranca.jar

Restart=on-failure
RestartSec=10
# 143 = encerramento por SIGTERM (JVM): parada normal.
SuccessExitStatus=143
KillMode=mixed
KillSignal=SIGTERM
TimeoutStartSec=300
TimeoutStopSec=60

# Limites
LimitNOFILE=65536
LimitNPROC=8192
TasksMax=4096
LimitCORE=0

# Isolamento
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
ReadWritePaths=/var/log/gestor-cobranca /var/lib/gestor-cobranca
ReadOnlyPaths=/opt/gestor-cobranca /etc/gestor-cobranca

[Install]
WantedBy=multi-user.target
