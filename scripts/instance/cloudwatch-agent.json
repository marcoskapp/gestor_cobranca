{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "cwagent",
    "logfile": "/opt/aws/amazon-cloudwatch-agent/logs/amazon-cloudwatch-agent.log"
  },
  "logs": {
    "force_flush_interval": 5,
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/gestor-cobranca/technical.log",
            "log_group_name": "/gestor-cobranca/__ENVIRONMENT__/technical",
            "log_stream_name": "{instance_id}",
            "retention_in_days": -1
          },
          {
            "file_path": "/var/log/gestor-cobranca/business.log",
            "log_group_name": "/gestor-cobranca/__ENVIRONMENT__/business",
            "log_stream_name": "{instance_id}",
            "retention_in_days": -1
          },
          {
            "file_path": "/var/log/gestor-cobranca/access.log",
            "log_group_name": "/gestor-cobranca/__ENVIRONMENT__/access",
            "log_stream_name": "{instance_id}",
            "retention_in_days": -1
          },
          {
            "file_path": "/var/log/gestor-cobranca/bootstrap.log",
            "log_group_name": "/gestor-cobranca/__ENVIRONMENT__/technical",
            "log_stream_name": "{instance_id}/bootstrap",
            "retention_in_days": -1
          },
          {
            "file_path": "/var/log/gestor-cobranca/migrate/technical.log",
            "log_group_name": "/gestor-cobranca/__ENVIRONMENT__/technical",
            "log_stream_name": "{instance_id}/migrate",
            "retention_in_days": -1
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "__HOST_METRICS_NAMESPACE__",
    "append_dimensions": {
      "AutoScalingGroupName": "${aws:AutoScalingGroupName}",
      "InstanceId": "${aws:InstanceId}"
    },
    "aggregation_dimensions": [
      ["AutoScalingGroupName"]
    ],
    "metrics_collected": {
      "mem": {
        "measurement": ["mem_used_percent", "mem_available"]
      },
      "disk": {
        "resources": ["/"],
        "measurement": ["used_percent", "inodes_free"],
        "drop_device": true
      },
      "swap": {
        "measurement": ["swap_used_percent"]
      },
      "netstat": {
        "measurement": ["tcp_established", "tcp_time_wait"]
      }
    }
  }
}
